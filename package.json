{
	"name": "@nudeui/icons",
	"version": "0.0.2",
	"description": "CSS-only icon system: icons are design tokens, placed with a custom property, rendered with a mask",
	"keywords": [
		"icons",
		"css",
		"design-systems",
		"design-tokens",
		"ui"
	],
	"homepage": "https://github.com/nudeui/icons/#readme",
	"bugs": {
		"url": "https://github.com/nudeui/icons/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nudeui/icons.git"
	},
	"files": [
		"icons.css",
		"icons-mixins.css",
		"skills"
	],
	"license": "MIT",
	"author": "Lea Verou",
	"funding": [
		{
			"type": "individual",
			"url": "https://github.com/sponsors/LeaVerou"
		}
	],
	"type": "module",
	"style": "icons.css",
	"exports": {
		".": "./icons.css",
		"./mixins": "./icons-mixins.css"
	},
	"scripts": {
		"build": "postcss icons-mixins.css -o icons.css && prettier --write icons.css",
		"dev": "postcss icons-mixins.css -o icons.css --watch",
		"prepack": "npm run build",
		"release": "npm whoami >/dev/null 2>&1 || npm login && release-it"
	},
	"devDependencies": {
		"@csstools/postcss-mixins": "^1.1.0",
		"postcss": "^8",
		"postcss-cli": "^11",
		"prettier": "~3.5.3",
		"prettier-plugin-brace-style": "latest",
		"prettier-plugin-merge": "latest",
		"prettier-plugin-space-before-function-paren": "latest",
		"release-it": "latest"
	}
}
